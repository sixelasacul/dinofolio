const dinos = (await getCollection("dinos")).toSorted(
  (first, second) =>
    first.data.createdAt.getTime() - second.data.createdAt.getTime()
);
---

<Layout>
  <div class="grid grid-cols-1 gap-4 place-items-center">
    <ul class="grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-4">
      {
        dinos.map((dino) => (
          <li>
            <a href={`/dinos/${dino.id}`}>
              <GradientImageCard isAnimated class="rounded-2xl">
                <div class="flex flex-col items-center transition-all gap-2 p-4 hover:p-8 hover:gap-0 hover:pb-10 group w-md">
                  {/* <Image> */}
                  <img
                    transition:name={`image-${dino.id}`}
                    class="rounded-2xl w-md aspect-square object-cover transition-transform rotate-0 group-hover:rotate-2"
                    src={dino.data.image}
                    alt={dino.data.title}
                    loading="eager"
                  />
                  {/* adding a padding equal to the one applied to the card when it's hovered to make sure the text width is always the same, avoiding line break during transition */}
                  <h2 class="px-4 group-hover:px-0 text-neutral-50 font-heading text-center transition-all rotate-0 group-hover:rotate-2">
                    {dino.data.title}
                  </h2>
                </div>
              </GradientImageCard>
            </a>
          </li>
        ))
      }
    </ul>
