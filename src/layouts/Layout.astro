---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Roboto+Mono&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Dinofolio - Laurazaurus</title>
    <ClientRouter />
  </head>
  <body class="overflow-hidden font-body">
    <div class="h-screen overflow-y-scroll backdrop-blur-sm">
      <div class="sticky top-0 z-10 flex justify-center backdrop-blur-sm">
        <a href="/">
          <h1
            class="inline-block font-display text-center text-neutral-50 p-4 transition-transform rotate-0 hover:rotate-6"
            id="title"
          >
            Dinofolio
          </h1>
        </a>
      </div>
      <div class="p-4 pt-0"><slot /></div>
    </div>
    <div id="background"></div>
  </body>
</html>

<style is:global>
  #background {
    position: absolute;
    z-index: -1;
    inset: -50%;
    height: 200vh;
    width: 200vw;
    transform: rotate(20deg);
    /* https://stackoverflow.com/questions/35361986/css-gradient-checkerboard-pattern */
    background: repeating-conic-gradient(
        var(--color-neutral-900) 0% 25%,
        transparent 0% 50%
      )
      50% / 160px 160px;
  }

  /* it'd be nice to have the gradient (green orange) show on hover */
  #title {
    -webkit-text-stroke-width: 2px;
    -webkit-text-stroke-color: var(--color-neutral-900);
  }
</style>
